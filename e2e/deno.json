{
  "tasks": {
    "install:browsers": "deno run --node-modules-dir=none -A @playwright/test install --with-deps chromium webkit",
    "install:browsers:ci": "bash scripts/install-ci-browsers.sh",
    "docsite:navigation:raw": "deno run --node-modules-dir=none -A @playwright/test test docsite-mobile-nav.test.ts docsite-links.test.ts",
    "docsite:navigation": "bash scripts/run-docsite-navigation.sh",
    "smoke": "deno run --node-modules-dir=none -A @playwright/test test smoke.test.ts entry-query-late-response.test.ts",
    "composition-metric": "deno run --node-modules-dir=auto -A @playwright/test test composition-metric-journey.test.ts composition-table-metric-pagination.test.ts",
    "composition-binding-rebind": "deno run --node-modules-dir=auto -A @playwright/test test composition-binding-rebind.test.ts",
    "composition-form-schema-drift": "deno run --node-modules-dir=auto -A @playwright/test test composition-form-schema-drift.test.ts",
    "composition-source-acl-isolation": "deno run --node-modules-dir=auto -A @playwright/test test composition-source-acl-isolation.test.ts",
    "native-zoom-200": "deno run --node-modules-dir=auto -A @playwright/test test native-zoom-200.test.ts --headed",
    "composition-golden": "deno run --node-modules-dir=auto -A @playwright/test test composition-golden-journey.test.ts",
    "late-query-response": "deno run --node-modules-dir=none -A @playwright/test test entry-query-late-response.test.ts",
    "entries": "deno run --node-modules-dir=none -A @playwright/test test entries.test.ts",
    "navigation": "deno run --node-modules-dir=none -A @playwright/test test navigation.test.ts",
    "asset-owned": "deno run --node-modules-dir=none -A @playwright/test test entries.test.ts --grep REQ-FE-1877",
    "smoke-and-asset-owned": "deno run --node-modules-dir=none -A @playwright/test test smoke.test.ts entries.test.ts entry-query-late-response.test.ts saved-sql-route.test.ts sql-filter-arguments.test.ts --grep \"@smoke|@asset-owned\"",
    "owner-recovery": "deno run --node-modules-dir=none -A @playwright/test test owner-space-recovery.test.ts",
    "portable-space": "deno run --node-modules-dir=none -A @playwright/test test portable-space-onboarding.test.ts",
    "forms": "deno run --node-modules-dir=none -A @playwright/test test forms.test.ts",
    "knowledge-journey": "deno run --node-modules-dir=none -A @playwright/test test knowledge-journey.test.ts",
    "mobile-ui": "deno run --node-modules-dir=none -A @playwright/test test ui-mobile-regression.test.ts compact-controls-evidence.test.ts login-responsive.test.ts entry-browser-ux.test.ts search-ui.test.ts result-surface-narrow.test.ts",
    "query-measurement": "deno run --node-modules-dir=none -A @playwright/test test query-surfaces-measurement.test.ts",
    "sql-export-remote-auth": "deno run --node-modules-dir=none -A @playwright/test test sql-export-remote-auth.test.ts",
    "saved-sql-route": "deno run --node-modules-dir=none -A @playwright/test test saved-sql-route.test.ts",
    "full": "deno run --node-modules-dir=none -A @playwright/test test --grep-invert @screenshot",
    "screenshot": "deno run --node-modules-dir=none -A @playwright/test test ui-pages-screenshots.test.ts",
    "composition-studio": "deno run --node-modules-dir=auto -A @playwright/test test composition-studio-journey.test.ts composition-golden-journey.test.ts composition-invalid-variable-input.test.ts composition-latest-variable-generation.test.ts composition-revision-stale-response.test.ts composition-scalar-state-journey.test.ts composition-stale-response.test.ts composition-binding-rebind.test.ts composition-form-schema-drift.test.ts composition-table-mobile.test.ts composition-recovery-authorization.test.ts",
    "composition-variable-name": "deno run --node-modules-dir=auto -A @playwright/test test composition-studio-journey.test.ts --grep \"Composition Studio prevents duplicate variable IDs in query creation\""
  },
  "imports": {
    "@playwright/test": "npm:@playwright/test@^1.60.0",
    "yaml": "npm:yaml@^2.9.1"
  }
}
