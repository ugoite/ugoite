{
  "tasks": {
    "install:browsers": "deno run -A npm:playwright install chromium",
    "smoke": "deno run -A npm:playwright test smoke.test.ts",
    "entries": "deno run -A npm:playwright test entries.test.ts",
    "forms": "deno run -A npm:playwright test forms.test.ts",
    "full": "deno run -A npm:playwright test --grep-invert @screenshot",
