{
	"name": "ugoite-docsite",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host 127.0.0.1 --strictPort --port 4321",
		"build": "astro build",
		"preview": "astro preview --host",
		"typecheck": "astro check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage --maxWorkers=1",
		"test:validation": "bun run build",
		"validate": "bun run typecheck && bun run test:validation && bun run test:coverage"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@tailwindcss/vite": "4.3.0",
		"astro": "^6.4.2",
		"marked": "^18.0.4",
		"prismjs": "1.30.0",
		"tailwindcss": "4.3.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "^4.1.8",
		"typescript": "^6.0.3",
		"vite": "8.0.16",
		"vitest": "^4.1.8"
	}
}
