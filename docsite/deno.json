    "@oslojs/encoding": "npm:@oslojs/encoding@1.1.0",
    "@tailwindcss/oxide": "npm:@tailwindcss/oxide@4.3.5",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.5",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@5.1.1",
    "clsx": "npm:clsx@2.1.1",
    "cookie": "npm:cookie@2.0.2",
    "devalue": "npm:devalue@6.0.4",
    "destr": "npm:destr@2.0.5",
    "es-module-lexer": "npm:es-module-lexer@3.0.5",
    "fontace": "npm:fontace@0.4.1",
    "fs": "node:fs",
