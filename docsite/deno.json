{
  "tasks": {
    "dev": "deno run -A astro dev --host 127.0.0.1 --strictPort --port 4321",
    "build": "deno run -A astro build",
    "preview:e2e": "deno run -A astro preview --host 127.0.0.1 --strictPort --port 4321",
    "check": "deno run -A astro check",
    "test": "deno run -A vitest run",
    "coverage": "deno run -A vitest run --coverage --maxWorkers=1"
  },
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@0.9.12",
    "@astrojs/internal-helpers/": "npm:@astrojs/internal-helpers@0.13.2/",
