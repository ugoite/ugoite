{
  "version": "0.1",
  "keywords": [
    "SELECT",
    "FROM",
    "WHERE",
    "JOIN",
    "LEFT",
    "INNER",
    "RIGHT",
    "FULL",
    "OUTER",
    "CROSS",
    "NATURAL",
    "USING",
    "ON",
    "ORDER",
    "BY",
    "LIMIT",
    "AND",
    "OR",
    "NOT"
  ],
  "lint": {
    "require_select": true,
    "require_from": false,
    "single_statement_only": true,
    "limit_requires_number": true
  },
  "feature_matrix": {
    "version": 1,
    "backend": {
      "statement_gate": "exactly_one_select_query_statement",
      "query_body_form_restricted": true,
      "clause_admission": "datafusion_parser_and_planner",
      "closed_clause_allowlist": false,
      "function_policy": "ReadOnlyAggregateV1",
      "functions": {
        "scalar": [],
        "aggregate": ["count", "sum", "avg", "min", "max"],
        "window": []
      },
      "function_aliases": {
        "aggregate": { "mean": "avg" }
      }
    },
    "direct_sql_lint": {
      "require_from": false,
      "fromless_select_diagnostic": "none"
    },
    "editor": {
      "aggregate_contract": {
        "checked": "name_catalog_only",
        "known_editor_rejections": ["COUNT(DISTINCT *)", "MEAN"],
        "verification_gaps": [
          "runtime_structure_frontend_signature_and_type_parity",
          "supported_aggregate_modifier_parity",
          "count_distinct_wildcard_execution_semantics",
          "aggregate_alias_parity"
        ]
      },
      "operations": [
        {
          "action": "form",
          "protocol": "set_relation",
          "sql": ["FROM"],
          "coverage": "bounded"
        },
        {
          "action": "join",
          "toolbar_category": "structure",
          "protocol": "set_join",
          "sql": ["JOIN", "ON"],
          "coverage": "bounded"
        },
        {
          "action": "columns",
          "protocol": "set_projection_slots",
          "sql": ["SELECT projection"],
          "coverage": "bounded"
        },
        {
          "action": "filter",
          "protocol": "set_filter_expression",
          "sql": ["WHERE"],
          "coverage": "typed predicates with nested AND, OR, and NOT; groups are bounded to depth 32 and 128 nodes"
        },
        {
          "action": "sort",
          "protocol": "set_sort",
          "sql": ["ORDER BY"],
          "coverage": "bounded"
        },
        {
          "action": "aggregate",
          "protocol": "set_aggregates",
          "sql": ["SELECT aggregate projection"],
          "coverage": "bounded",
          "functions": ["count", "sum", "avg", "min", "max"]
        },
        {
          "action": "group_by",
          "protocol": "set_group_by",
          "sql": ["GROUP BY"],
          "coverage": "bounded"
        },
        {
          "action": "distinct",
          "protocol": "set_distinct",
          "sql": ["SELECT DISTINCT"],
          "coverage": "bounded"
        }
      ],
      "literal_projection_operation": {
        "action": "columns",
        "protocol": "set_literal_projection",
        "sql": ["relation-free SELECT literal projection"],
        "coverage": "bounded",
        "values": ["integer", "string", "boolean", "null"]
      },
      "legacy_operations": [
        {
          "protocol": "set_filters",
          "coverage": "flat conjunction of typed predicates"
        }
      ],
      "constructs": [
        {
          "id": "from_relation",
          "sql": "FROM",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "one relation selected from trusted Form context",
            "relation-free SELECT 1 draft can select a Form",
            "plain aliases on a single relation are supported and preserved; edited column references remain unqualified",
            "self-join relations are resolved from the same trusted Form context"
          ]
        },
        {
          "id": "projection",
          "sql": "SELECT",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "relation-free integer/string/boolean/NULL literal projections",
            "typed literal projection edits are restricted to those relation-free literals",
            "wildcard or simple columns",
            "simple Form-column projection aliases are inspected and edited independently by SQL-document-scoped projection slot identity",
            "alias edits that would change ORDER BY output-name binding fail closed",
            "projection-slot identities allow repeated source columns to be independently edited, added, removed, and reordered",
            "repeated source columns remain editable, reorderable, and independently aliasable by projection slot",
            "allowlisted aggregates over supported arguments"
          ]
        },
        {
          "id": "where_predicate",
          "sql": "WHERE",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "AND of column-to-parameter comparisons",
            "IS NULL and IS NOT NULL",
            "no OR or NOT"
          ]
        },
        {
          "id": "grouping",
          "sql": "GROUP BY",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": ["simple columns only", "projected columns must be grouped"]
        },
        {
          "id": "having",
          "sql": "HAVING",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        },
        {
          "id": "ordering",
          "sql": "ORDER BY",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "simple columns only",
            "unqualified identifiers resolve explicit projection aliases before same-named Form columns; the editor retains the typed source binding",
            "ASC or DESC",
            "no NULLS FIRST/LAST"
          ]
        },
        {
          "id": "row_limit",
          "sql": "LIMIT/OFFSET",
          "backend_admission": "planner_decides",
          "editor_coverage": "preserved_only",
          "limits": [
            "the structure parser recognizes non-negative integer literals",
            "there is no edit operation"
          ]
        },
        {
          "id": "joins",
          "sql": "JOIN",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "one INNER self-join of the selected Form with explicit distinct aliases",
            "ON must be left_alias.column = right_alias.column with matching supported scalar types; reversed equality operands fail closed",
            "wildcard projection only; editing ON preserves other SQL source text",
            "WHERE supports bounded AND/OR/NOT trees of qualified parameter comparisons plus IS NULL/IS NOT NULL on qualified columns; adding a JOIN qualifies every supported predicate leaf; ORDER BY supports simple qualified columns with ASC/DESC and no NULLS FIRST/LAST; unqualified references fail closed",
            "filter and sort edits fail closed when comments in the query could be lost by AST serialization",
            "adding a join qualifies existing supported single-relation WHERE/ORDER BY columns with the left alias and preserves surrounding clause text",
            "unquoted aliases and columns resolve with SQL case folding; quoted identifiers remain exact",
            "LEFT/RIGHT/FULL/CROSS/NATURAL/USING, multiple joins, derived relations, reversed equality operands, and other ON expressions fail closed"
          ]
        },
        {
          "id": "common_table_expressions",
          "sql": "WITH",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        },
        {
          "id": "set_operations",
          "sql": "UNION/INTERSECT/EXCEPT",
          "backend_admission": "planner_decides",
          "editor_coverage": "none",
          "limits": [
            "every set-operation operand must be a SELECT query body"
          ]
        },
        {
          "id": "values_query",
          "sql": "VALUES",
          "backend_admission": "statement_gate_rejects",
          "editor_coverage": "none"
        },
        {
          "id": "table_query",
          "sql": "TABLE",
          "backend_admission": "statement_gate_rejects",
          "editor_coverage": "none"
        },
        {
          "id": "general_expressions",
          "sql": "CASE/CAST/arithmetic/scalar functions",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        }
      ]
    }
  }
}
