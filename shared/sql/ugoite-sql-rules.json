{
  "version": "0.1",
  "keywords": [
    "SELECT",
    "FROM",
    "WHERE",
    "JOIN",
    "LEFT",
    "INNER",
    "RIGHT",
    "FULL",
    "OUTER",
    "CROSS",
    "NATURAL",
    "USING",
    "ON",
    "ORDER",
    "BY",
    "LIMIT",
    "AND",
    "OR",
    "NOT"
  ],
  "lint": {
    "require_select": true,
    "require_from": false,
    "single_statement_only": true,
    "limit_requires_number": true
  },
  "feature_matrix": {
    "version": 2,
    "backend": {
      "statement_gate": "exactly_one_select_query_statement",
      "query_body_form_restricted": true,
      "clause_admission": "datafusion_parser_and_planner",
      "parser_engine": {
        "crate": "datafusion",
        "version": "54.1.0"
      },
      "closed_clause_allowlist": false,
      "function_policy": "ReadOnlyAggregateV1",
      "plan_validation": "authorized_logical_and_physical_plan",
      "query_body_policy": {
        "query_statement": "exactly_one",
        "query_body": "select_only_recursively",
        "set_operations": "select_operands_only",
        "nested_queries": "select_bodies_only"
      },
      "functions": {
        "scalar": [],
        "aggregate": ["count", "sum", "avg", "min", "max"],
        "window": []
      },
      "function_aliases": {
        "aggregate": { "mean": "avg" }
      },
      "statement_gate_canaries": {
        "admitted": [
          "SELECT 1",
          "SELECT 1 UNION SELECT 2",
          "WITH items AS (SELECT 1 AS value) SELECT value FROM items",
          "WITH RECURSIVE items AS (SELECT 1 AS value) SELECT value FROM items",
          "SELECT * FROM (SELECT 1 AS value) AS items",
          "SELECT 1 WHERE EXISTS (SELECT 1)",
          "SELECT 1 WHERE 1 IN (SELECT 1)"
        ],
        "rejected": [
          "VALUES (1)",
          "SELECT 1 UNION VALUES (2)",
          "WITH items AS (VALUES (1)) SELECT * FROM items",
          "SELECT * FROM (VALUES (1)) AS items(value)",
          "TABLE items",
          "INSERT INTO items SELECT 1",
          "UPDATE items SET value = 1",
          "DELETE FROM items",
          "DROP TABLE items",
          "SELECT 1; SELECT 2"
        ]
      },
      "function_policy_canaries": {
        "admitted": [
          "SELECT COUNT(*)",
          "SELECT SUM(1)",
          "SELECT AVG(1)",
          "SELECT MEAN(1)",
          "SELECT MIN(1)",
          "SELECT MAX(1)"
        ],
        "planner_rejects": [
          "SELECT LOWER('value')",
          "SELECT ROW_NUMBER() OVER ()"
        ],
        "plan_policy_rejects": [
          "SELECT COUNT(1) OVER ()"
        ]
      }
    },
    "direct_sql_lint": {
      "require_from": false,
      "fromless_select_diagnostic": "none"
    },
    "editor": {
      "aggregate_contract": {
        "checked": "registry_signature_and_gui_roundtrip",
        "known_editor_rejections": [],
        "verification_gaps": ["aggregate_expression_arguments_outside_form_columns"]
      },
      "operations": [
        {
          "action": "form",
          "protocol": "set_relation",
          "sql": ["FROM"],
          "coverage": "bounded"
        },
        {
          "action": "join",
          "toolbar_category": "structure",
          "protocol": "set_join",
          "sql": ["JOIN", "ON"],
          "coverage": "bounded"
        },
        {
          "action": "columns",
          "protocol": "set_projection_slots",
          "sql": ["SELECT projection"],
          "coverage": "bounded"
        },
        {
          "action": "filter",
          "protocol": "set_filter_expression",
          "sql": ["WHERE"],
          "coverage": "typed predicates with nested AND, OR, and NOT; groups are bounded to depth 32 and 128 nodes"
        },
        {
          "action": "sort",
          "protocol": "set_sort",
          "sql": ["ORDER BY"],
          "coverage": "bounded"
        },
        {
          "action": "aggregate",
          "protocol": "set_aggregates",
          "sql": ["SELECT aggregate projection"],
          "coverage": "bounded",
          "functions": ["count", "sum", "avg", "mean", "min", "max"]
        },
        {
          "action": "group_by",
          "protocol": "set_group_by",
          "sql": ["GROUP BY"],
          "coverage": "bounded"
        },
        {
          "action": "distinct",
          "protocol": "set_distinct",
          "sql": ["SELECT DISTINCT"],
          "coverage": "bounded"
        }
      ],
      "literal_projection_operation": {
        "action": "columns",
        "protocol": "set_literal_projection",
        "sql": ["relation-free SELECT literal projection"],
        "coverage": "bounded",
        "values": ["integer", "string", "boolean", "null"]
      },
      "legacy_operations": [
        {
          "protocol": "set_filters",
          "coverage": "flat conjunction of typed predicates"
        }
      ],
      "constructs": [
        {
          "id": "from_relation",
          "sql": "FROM",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "each scanned relation must resolve through the authorized Form context; SQL relation text does not grant access",
            "one relation selected from trusted Form context",
            "relation-free SELECT 1 draft can select a Form",
            "plain aliases on a single relation are supported and preserved; edited column references remain unqualified",
            "self-join relations are resolved from the same trusted Form context"
          ]
        },
        {
          "id": "projection",
          "sql": "SELECT",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "relation-free integer/string/boolean/NULL literal projections",
            "typed literal projection edits are restricted to those relation-free literals",
            "wildcard or simple columns",
            "simple Form-column projection aliases are inspected and edited independently by SQL-document-scoped projection slot identity",
            "alias edits that would change ORDER BY output-name binding fail closed",
            "projection-slot identities allow repeated source columns to be independently edited, added, removed, and reordered",
            "repeated source columns remain editable, reorderable, and independently aliasable by projection slot",
            "allowlisted aggregates over supported arguments"
          ]
        },
        {
          "id": "where_predicate",
          "sql": "WHERE",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "typed comparisons and null predicates",
            "IS NULL and IS NOT NULL",
            "bounded nested AND, OR, and NOT trees; at most 128 nodes and depth 32"
          ]
        },
        {
          "id": "grouping",
          "sql": "GROUP BY",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": ["simple columns only", "projected columns must be grouped"]
        },
        {
          "id": "having",
          "sql": "HAVING",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        },
        {
          "id": "ordering",
          "sql": "ORDER BY",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "simple columns only",
            "unqualified identifiers resolve explicit projection aliases before same-named Form columns; the editor retains the typed source binding",
            "ASC or DESC",
            "no NULLS FIRST/LAST"
          ]
        },
        {
          "id": "row_limit",
          "sql": "LIMIT/OFFSET",
          "backend_admission": "planner_decides",
          "editor_coverage": "preserved_only",
          "limits": [
            "the structure parser recognizes non-negative integer literals",
            "there is no edit operation"
          ]
        },
        {
          "id": "joins",
          "sql": "JOIN",
          "backend_admission": "planner_decides",
          "editor_coverage": "bounded",
          "limits": [
            "one INNER self-join of the selected Form with explicit distinct aliases",
            "ON must be left_alias.column = right_alias.column with matching supported scalar types; reversed equality operands fail closed",
            "wildcard projection only; editing ON preserves other SQL source text",
            "WHERE supports bounded AND/OR/NOT trees of qualified parameter comparisons plus IS NULL/IS NOT NULL on qualified columns; adding a JOIN qualifies every supported predicate leaf; ORDER BY supports simple qualified columns with ASC/DESC and no NULLS FIRST/LAST; unqualified references fail closed",
            "filter and sort edits fail closed when comments in the query could be lost by AST serialization",
            "adding a join qualifies existing supported single-relation WHERE/ORDER BY columns with the left alias and preserves surrounding clause text",
            "unquoted aliases and columns resolve with SQL case folding; quoted identifiers remain exact",
            "LEFT/RIGHT/FULL/CROSS/NATURAL/USING, multiple joins, derived relations, reversed equality operands, and other ON expressions fail closed"
          ]
        },
        {
          "id": "common_table_expressions",
          "sql": "WITH",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        },
        {
          "id": "set_operations",
          "sql": "UNION/INTERSECT/EXCEPT",
          "backend_admission": "planner_decides",
          "editor_coverage": "none",
          "limits": [
            "every set-operation operand must be a SELECT query body"
          ]
        },
        {
          "id": "values_query",
          "sql": "VALUES",
          "backend_admission": "statement_gate_rejects",
          "editor_coverage": "none"
        },
        {
          "id": "table_query",
          "sql": "TABLE",
          "backend_admission": "statement_gate_rejects",
          "editor_coverage": "none"
        },
        {
          "id": "general_expressions",
          "sql": "CASE/CAST/arithmetic and other non-function expression syntax",
          "backend_admission": "planner_decides",
          "editor_coverage": "none"
        },
        {
          "id": "scalar_functions",
          "sql": "scalar functions",
          "backend_admission": "function_policy_rejects",
          "editor_coverage": "none",
          "limits": [
            "ReadOnlyAggregateV1 registers no user SQL scalar functions"
          ]
        },
        {
          "id": "window_functions",
          "sql": "user SQL window functions",
          "backend_admission": "function_policy_rejects",
          "editor_coverage": "none",
          "limits": [
            "ReadOnlyAggregateV1 registers no user SQL window functions"
          ]
        },
        {
          "id": "aggregate_window_expressions",
          "sql": "aggregate functions used with OVER",
          "backend_admission": "plan_policy_rejects",
          "editor_coverage": "none",
          "limits": [
            "an admitted aggregate used with OVER can be planned",
            "the authorized logical-plan validator rejects Window plans"
          ]
        },
        {
          "id": "recursive_queries",
          "sql": "recursive CTEs",
          "backend_admission": "plan_policy_rejects",
          "editor_coverage": "none",
          "limits": [
            "a SELECT-only statement shape does not imply an executable recursive query",
            "the authorized logical-plan validator rejects RecursiveQuery plans"
          ]
        },
        {
          "id": "table_functions",
          "sql": "user-authored table functions",
          "backend_admission": "planner_rejects_unregistered",
          "editor_coverage": "none",
          "limits": [
            "the user SQL session registers no table functions"
          ]
        },
        {
          "id": "user_unnest",
          "sql": "user-authored UNNEST",
          "backend_admission": "plan_policy_rejects",
          "editor_coverage": "none",
          "limits": [
            "the authorized logical-plan validator rejects user-authored UNNEST"
          ]
        }
      ]
    }
  }
}
