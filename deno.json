{
  "workspace": [
    "frontend",
    "docsite",
    "e2e",
    "tools"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A tools/dev.ts",
    "check": "deno check tools/**/*.ts",
    "test": "deno test -A tools/*_test.ts",
    "frontend:dev": "deno task --cwd frontend dev",
    "frontend:build": "deno task --cwd frontend build",
    "frontend:test": "deno task --cwd frontend test",
    "docsite:dev": "deno task --cwd docsite dev",
    "docsite:build": "deno task --cwd docsite build",
    "docsite:test": "deno task --cwd docsite test",
    "e2e:install:browsers": "deno task --cwd e2e install:browsers",
    "e2e:smoke": "deno task --cwd e2e smoke",
    "e2e:full": "deno task --cwd e2e full"
  },
  "fmt": {
    "include": [
      "tools",
      "deno.json",
      "frontend/deno.json",
      "docsite/deno.json",
      "e2e/deno.json",
      "docs/architecture/release-rearchitecture.md"
    ],
    "exclude": [
      "target",
      "dist",
      ".output",
      "node_modules",
      "docs/spec/api/openapi.yaml"
    ]
  },
  "lint": {
    "include": ["tools"]
  }
}
