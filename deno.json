{
  "workspace": [
    "frontend",
    "docsite",
    "e2e",
    "tools"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "sharp": "npm:sharp@0.35.5"
  },
  "tasks": {
    "dev": "deno run -A tools/dev.ts",
    "check": "deno check tools/**/*.ts e2e/**/*.ts && deno task --cwd frontend check && deno task --cwd docsite check",
    "test": "deno test -A tools/*_test.ts && deno task frontend:test && deno task docsite:test",
    "frontend:dev": "deno task --cwd frontend dev",
    "frontend:build": "deno task --cwd frontend build",
    "frontend:test": "deno task --cwd frontend test",
    "brand:icons": "deno run -A frontend/scripts/generate-brand-icons.ts",
    "frontend:coverage": "deno task --cwd frontend coverage",
    "docsite:dev": "deno task --cwd docsite dev",
    "docsite:build": "deno task --cwd docsite build",
    "docsite:test": "deno task --cwd docsite test",
    "docsite:coverage": "deno task --cwd docsite coverage",
    "docsite:e2e:navigation": "deno task --cwd e2e docsite:navigation",
    "e2e:install:browsers": "deno task --cwd e2e install:browsers",
    "e2e:install:browsers:ci": "deno task --cwd e2e install:browsers:ci",
    "e2e:smoke": "bash e2e/scripts/run-e2e-parity.sh smoke",
    "e2e:composition-scalar-evaluation": "bash e2e/scripts/run-e2e-parity.sh composition-scalar-evaluation",
    "e2e:composition-table-pagination": "bash e2e/scripts/run-e2e-parity.sh composition-table-pagination",
    "e2e:composition-binding-rebind": "bash e2e/scripts/run-e2e-parity.sh composition-binding-rebind",
    "e2e:composition-source-acl-isolation": "bash e2e/scripts/run-e2e-parity.sh composition-source-acl-isolation",
    "e2e:late-query-response": "bash e2e/scripts/run-e2e.sh late-query-response",
    "e2e:asset-owned": "bash e2e/scripts/run-e2e-parity.sh asset-owned",
    "e2e:smoke-and-asset-owned": "bash e2e/scripts/run-e2e-parity.sh smoke-and-asset-owned",
    "e2e:navigation": "bash e2e/scripts/run-e2e-parity.sh navigation",
    "e2e:owner-recovery": "COMPOSE_PROJECT_NAME=ugoite-owner-recovery E2E_COMPOSE_PORT=18001 PLAYWRIGHT_JUNIT_OUTPUT_FILE=test-results/owner-recovery-junit.xml bash e2e/scripts/run-e2e-parity.sh owner-recovery",
    "e2e:mobile-ui": "bash e2e/scripts/run-e2e-parity.sh mobile-ui",
    "e2e:query-measurement": "bash e2e/scripts/run-e2e.sh query-measurement",
    "e2e:saved-sql-route": "bash e2e/scripts/run-e2e-parity.sh saved-sql-route",
    "e2e:portable-space": "bash e2e/scripts/run-e2e-parity.sh portable-space",
    "e2e:full": "bash e2e/scripts/run-e2e-parity.sh full",
    "e2e:static": "E2E_FRONTEND_MODE=static E2E_ENFORCE_CI_GATES=true bash e2e/scripts/run-e2e.sh smoke",
    "mitase:sync": "deno run -A tools/mitase_sync.ts",
    "e2e:composition-studio": "bash e2e/scripts/run-e2e-parity.sh composition-studio",
    "e2e:composition-variable-name": "E2E_BUILD_IMAGES=false bash e2e/scripts/run-e2e-parity.sh composition-variable-name"
  },
  "fmt": {
    "include": [
      "tools",
      "deno.json",
      "frontend/deno.json",
      "docsite/deno.json",
      "e2e/deno.json",
      "docs/architecture/principles/north-star.md",
      "docs/architecture/api",
      "docs/architecture/release/release-rearchitecture.md",
      "docs/architecture/release/release-contract.md",
      "docs/architecture/release/release-scope.md",
      "docs/architecture/release/platform-support.md"
    ],
    "exclude": [
      "target",
      "dist",
      ".output",
      "node_modules"
    ]
  },
  "lint": {
    "include": [
      "tools",
      "e2e",
      "frontend/src",
      "docsite/src"
    ],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-sloppy-imports",
        "no-unused-vars",
        "no-window",
        "no-window-prefix",
        "require-await",
        "jsx-boolean-value",
        "jsx-curly-braces"
      ]
    }
  },
  "scopes": {
    "./docsite/": {
      "@astrojs/starlight": "npm:@astrojs/starlight@0.41.11",
      "@tailwindcss/node": "npm:@tailwindcss/node@4.3.5",
      "astro": "npm:astro@7.4.13",
      "zod": "npm:zod@4.6.7"
    },
    "./frontend/": {
      "@solidjs/start": "npm:@solidjs/start@^1.5.1",
      "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^8.0.0",
      "@vinxi/server-components": "npm:@vinxi/server-components@^0.5.1",
      "msw": "npm:msw@^3.0.7",
      "vinxi": "npm:vinxi@^0.5.11",
      "vitest/config": "npm:vitest@^5.1.1/config"
    },
    "./tools/": {
      "@std/assert": "jsr:@std/assert@1.0.19"
    }
  }
}
