{
  "tasks": {
    "dev": "deno run -A vinxi dev",
    "build": "deno cache scripts/cache-build-dependencies.ts && sh -c 'mkdir -p node_modules && for pkg in solid-js tailwindcss; do test -e node_modules/$pkg || tar -C ../node_modules -chf - $pkg | tar -C node_modules -xf -; done' && deno run -A vinxi build && deno run -A scripts/generate-build-info.ts",
    "check": "deno check app.config.ts error-handler.ts scripts/generate-brand-icons.ts scripts/generate-build-info.ts scripts/generate-static-index.ts vitest.config.ts",
    "start": "deno run -A vinxi start",
    "test": "deno run -A vitest run",
    "coverage": "deno run -A vitest run --coverage --maxWorkers=1"
  },
  "imports": {
