{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": {
    "enabled": true
  },
  "dependencyDashboardApproval": false,
  "prCreation": "immediate",
  "automerge": false,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "groupSingleUpdates": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": false
  },
  "enabledManagers": [
    "cargo",
    "deno",
    "npm",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "devcontainer",
    "rust-toolchain",
    "mise",
    "renovate-config",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned self-hosted Renovate CLI version",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate-version:\\s*[\\\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"']?\\s*# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "One daily update group for the Rust Cargo workspace ecosystem",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "cargo-workspace",
      "groupSlug": "cargo-workspace"
    },
    {
      "description": "One daily update group for the Deno workspace (all five deno.json files and root deno.lock) ecosystem",
      "matchManagers": [
        "deno"
      ],
      "groupName": "deno-workspace",
      "groupSlug": "deno-workspace"
    },
    {
      "description": "One daily update group for the GitHub Actions ecosystem",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "One daily update group for the Dockerfile and Docker Compose ecosystem",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "docker",
      "groupSlug": "docker"
    },
    {
      "description": "One daily update group for the Dev Containers ecosystem",
      "matchManagers": [
        "devcontainer"
      ],
      "groupName": "devcontainers",
      "groupSlug": "devcontainers"
    },
    {
      "description": "One daily update group for the npm package ecosystem",
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm",
      "groupSlug": "npm"
    },
    {
      "description": "One daily update group for the mise tools ecosystem",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise-tools",
      "groupSlug": "mise-tools"
    },
    {
      "description": "One daily update group for the Rust toolchain ecosystem",
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": "rust-toolchain",
      "groupSlug": "rust-toolchain"
    },
    {
      "description": "One daily update group for the Renovate CLI self update ecosystem",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "renovate-cli",
      "groupSlug": "renovate-cli"
    },
    {
      "description": "One daily update group for the Renovate configuration ecosystem",
      "matchManagers": [
        "renovate-config"
      ],
      "groupName": "renovate-config",
      "groupSlug": "renovate-config"
    },
    {
      "description": "Exclude only observed Starlight versions failing astro:middleware",
      "matchPackageNames": [
        "@astrojs/starlight"
      ],
      "allowedVersions": "!/^(?:0\\.42\\.(?:[0-9]|1[01])|0\\.43\\.[01])$/"
    },
    {
      "description": "Exclude observed Playwright versions breaking module loading",
      "matchPackageNames": [
        "@playwright/test"
      ],
      "allowedVersions": "!/^(?:1\\.(?:61\\.[01]|62\\.[01]|63\\.0|64\\.[01]|65\\.[01]))$/"
    },
    {
      "description": "Exclude observed SolidStart versions lacking defineConfig",
      "matchPackageNames": [
        "@solidjs/start"
      ],
      "allowedVersions": "!/^(?:2\\.0\\.[0-6]|2\\.1\\.0|2\\.2\\.[0-3])$/"
    },
    {
      "description": "Hold observed SolidJS runtime and router major candidates until the frontend supports their changed exports and reactive behavior",
      "matchManagers": [
        "deno"
      ],
      "matchPackageNames": [
        "solid-js",
        "@solidjs/router"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Preserve Dependabot policy: TypeScript major updates remain blocked until frontend compiler API support is proven",
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Preserve Dependabot policy: Arrow/Parquet/Iceberg/DataFusion/OpenDAL major or minor coordinated upgrades are held; patches join Cargo group",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "arrow*",
        "parquet",
        "iceberg*",
        "datafusion*",
        "opendal*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Hold non-vulnerability keyring major updates until the CLI no longer requests the removed apple-native feature",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "keyring"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchJsonata": [
        "$not($exists(isVulnerabilityAlert) and isVulnerabilityAlert)"
      ],
      "enabled": false
    },
    {
      "description": "Hold non-vulnerability rig-agent minor and major updates until the adapter has a behavior-verified migration",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "rig-agent"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchJsonata": [
        "$not($exists(isVulnerabilityAlert) and isVulnerabilityAlert)"
      ],
      "enabled": false
    },
    {
      "description": "Hold non-vulnerability sqlparser minor and major updates until the pinned Iceberg and DataFusion boundary can move together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "sqlparser"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchJsonata": [
        "$not($exists(isVulnerabilityAlert) and isVulnerabilityAlert)"
      ],
      "enabled": false
    },
    {
      "description": "Keep the manually pinned Iceberg Git source revision outside automated updates",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/apache/iceberg-rust.git"
      ],
      "enabled": false
    },
    {
      "description": "Exclude the observed Ubuntu 26.04 runner until the pinned Playwright browser tooling supports it",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "!/^(?:26\\.04)$/"
    },
    {
      "description": "Preserve node engines support floor as a product contract, not a routine tool update",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "matchPackageNames": [
        "node"
      ],
      "enabled": false
    },
    {
      "description": "Do not double track pinned Renovate container via github-actions manager",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "enabled": false
    }
  ]
}
