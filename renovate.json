{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": {
    "enabled": true
  },
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "major": {
    "dependencyDashboardApproval": true
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "enabledManagers": [
    "cargo",
    "deno",
    "npm",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "devcontainer",
    "rust-toolchain",
    "mise",
    "renovate-config",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned Renovate CLI used by the self-hosted workflow",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "renovate-version:\\s*[\\\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"']?\\s*# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group routine ecosystem updates into a bounded daily proposal",
      "matchManagers": [
        "github-actions",
        "cargo",
        "dockerfile",
        "docker-compose",
        "devcontainer",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "all-dependencies"
    },
    {
      "description": "Group the shared Deno workspace lockfile updates weekly",
      "matchManagers": ["deno"],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "schedule": ["* * * * 1"],
      "groupName": "deno-workspace"
    },
    {
      "description": "Hold known failing Starlight releases until Docsite resolves astro:middleware",
      "matchPackageNames": ["@astrojs/starlight"],
      "allowedVersions": "!/^(?:0\\.42\\.(?:[1-9]|1[01])|0\\.43\\.[01])$/"
    },
    {
      "description": "Hold Playwright releases that break Docsite module loading",
      "matchPackageNames": ["@playwright/test"],
      "allowedVersions": "!/^(?:1\\.(?:61\\.[01]|62\\.[01]|63\\.0|64\\.[01]|65\\.[01]))$/"
    },
    {
      "description": "Hold SolidStart releases that remove the app config API",
      "matchPackageNames": ["@solidjs/start"],
      "allowedVersions": "!/^(?:2\\.0\\.[0-6]|2\\.1\\.0|2\\.2\\.[0-3])$/"
    },
    {
      "description": "Review Rust compiler updates monthly",
      "matchManagers": ["rust-toolchain"],
      "schedule": ["* * 1-7 * *"]
    },
    {
      "description": "Group mise-managed development tool updates monthly",
      "matchManagers": ["mise"],
      "schedule": ["* * 1-7 * *"],
      "groupName": "development-tools"
    },
    {
      "description": "Review Renovate CLI updates monthly during the first week",
      "matchManagers": ["custom.regex"],
      "schedule": ["* * 1-7 * *"]
    },
    {
      "description": "Track the Renovate CLI pin through its GitHub release version",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "enabled": false
    },
    {
      "description": "Keep the installer package Node.js support range under human review",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "Keep coordinated Arrow stack changes visible for review",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "arrow*",
        "parquet",
        "iceberg*",
        "datafusion*",
        "opendal*"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "rust-arrow-stack",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require dashboard approval for potentially breaking zero-major minor updates",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
