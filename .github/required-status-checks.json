{
  "version": 1,
  "ruleset": {
    "name": "main only pr",
    "target": "branch",
    "default_branch_only": true
  },
  "required_status_checks": [
    {
      "context": "ci-required",
      "workflow": ".github/workflows/ci.yml",
      "job_id": "required",
      "events": ["push", "pull_request", "merge_group"]
    },
    {
      "context": "codeql-required",
      "workflow": ".github/workflows/codeql.yml",
      "job_id": "required-check",
      "events": ["push", "pull_request", "merge_group"]
    },
    {
      "context": "require-close-issue-link",
      "workflow": ".github/workflows/pr-require-close-issue.yml",
      "job_id": "require-close-issue-link",
      "events": ["pull_request"]
    }
  ],
  "excluded_from_required_status_checks": [
    "Release CI",
    "Release Publish",
    "Docsite Pages"
  ]
}
